<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="usv_monde_leger">

    <!-- ═══ PHYSIQUE ═══════════════════════════════════════════════════════ -->
    <physics name="1ms" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══ PLUGINS MONDE ══════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"         name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system"   name="gz::sim::systems::Magnetometer"/>

    <!-- ═══ SCÈNE ET CIEL ══════════════════════════════════════════════════ -->
    <scene>
      <ambient>0.3 0.3 0.35 1.0</ambient>
      <background>0.53 0.81 0.98 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>10</speed>
          <direction>1.0</direction>
          <humidity>0.5</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
    </scene>

    <!-- ═══ ATMOSPHÈRE ═════════════════════════════════════════════════════ -->
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>
      <pressure>101325</pressure>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- ═══ ÉCLAIRAGE ══════════════════════════════════════════════════════ -->
    <!-- Soleil principal — ombres activées -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Lumière de remplissage douce — pas d'ombres -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.5 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.1 -0.9</direction>
    </light>

    <!-- ═══ OCÉAN ══════════════════════════════════════════════════════════ -->
    <model name="ocean_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.15 0.4 1.0</ambient>
            <diffuse>0.0 0.25 0.6 1.0</diffuse>
            <specular>0.8 0.8 0.9 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ USV WAM-V CATAMARAN ════════════════════════════════════════════ -->
    <model name="wamv">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>180.0</mass>
          <inertia>
            <ixx>120.0</ixx><iyy>393.0</iyy><izz>446.0</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <!-- ── COQUES ─────────────────────────────────────────────────── -->
        <!-- Coque bâbord (gauche) : cylindre horizontal selon X -->
        <visual name="hull_port">
          <pose>0 0.9 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>3.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>

        <!-- Coque tribord (droite) -->
        <visual name="hull_starboard">
          <pose>0 -0.9 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>3.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>

        <!-- ── BRAS AVANT ──────────────────────────────────────────────── -->
        <!-- Bras avant bâbord (y=0 → y=+0.9) -->
        <visual name="arm_front_port">
          <pose>1.2 0.45 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.1 0.9 0.08</size></box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- Bras avant tribord (y=0 → y=-0.9) -->
        <visual name="arm_front_starboard">
          <pose>1.2 -0.45 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.1 0.9 0.08</size></box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- ── BRAS ARRIÈRE ────────────────────────────────────────────── -->
        <!-- Bras arrière bâbord -->
        <visual name="arm_rear_port">
          <pose>-1.2 0.45 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.1 0.9 0.08</size></box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- Bras arrière tribord -->
        <visual name="arm_rear_starboard">
          <pose>-1.2 -0.45 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.1 0.9 0.08</size></box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- ── PLATEFORME CENTRALE ─────────────────────────────────────── -->
        <visual name="platform">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box><size>2.4 0.6 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>

        <!-- ── MÂT CENTRAL ────────────────────────────────────────────── -->
        <!-- Cylindre vertical, centre à z=0.4m, hauteur 0.8m -->
        <visual name="mast">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- ── BOÎTIERS PROPULSEURS ────────────────────────────────────── -->
        <!-- Propulseur bâbord arrière — jaune #FFD700 = (1.0, 0.843, 0.0) -->
        <visual name="thruster_housing_port">
          <pose>-1.8 0.9 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.08</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.843 0.0 1</ambient>
            <diffuse>1.0 0.843 0.0 1</diffuse>
            <specular>0.5 0.4 0.0 1</specular>
          </material>
        </visual>

        <!-- Propulseur tribord arrière -->
        <visual name="thruster_housing_starboard">
          <pose>-1.8 -0.9 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.08</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.843 0.0 1</ambient>
            <diffuse>1.0 0.843 0.0 1</diffuse>
            <specular>0.5 0.4 0.0 1</specular>
          </material>
        </visual>

        <!-- ── FEUX DE NAVIGATION ──────────────────────────────────────── -->
        <!-- Feu vert bâbord (gauche / port) -->
        <visual name="nav_light_port">
          <pose>1.6 0.9 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.05</radius></sphere>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
            <specular>0.0 0.3 0.0 1</specular>
          </material>
        </visual>

        <!-- Feu rouge tribord (droite / starboard) -->
        <visual name="nav_light_starboard">
          <pose>1.6 -0.9 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.05</radius></sphere>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.3 0.0 0.0 1</specular>
          </material>
        </visual>

        <!-- ── CAPTEURS (inchangés) ────────────────────────────────────── -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <topic>/wamv/sensors/imu</topic>
        </sensor>
        <sensor name="gps_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/wamv/sensors/gps</topic>
        </sensor>
        <sensor name="mag_sensor" type="magnetometer">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>/wamv/sensors/magnetometer</topic>
        </sensor>
      </link>

      <!-- ── HÉLICES (links + joints inchangés) ──────────────────────── -->
      <link name="left_propeller">
        <pose>-1.5 0.8 0.0 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.12</radius><length>0.05</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <joint name="left_engine_propeller_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_propeller</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <link name="right_propeller">
        <pose>-1.5 -0.8 0.0 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.12</radius><length>0.05</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <joint name="right_engine_propeller_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_propeller</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <!-- ── PLUGINS THRUSTER (inchangés) ────────────────────────────── -->
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>left_engine_propeller_joint</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.24</propeller_diameter>
        <velocity_control>true</velocity_control>
        <use_angvel_cmd>false</use_angvel_cmd>
        <topic>/wamv/thrusters/left/thrust</topic>
      </plugin>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>right_engine_propeller_joint</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.24</propeller_diameter>
        <velocity_control>true</velocity_control>
        <use_angvel_cmd>false</use_angvel_cmd>
        <topic>/wamv/thrusters/right/thrust</topic>
      </plugin>
    </model>

    <!-- ═══ COORDONNÉES SPHÉRIQUES (inchangées) ═══════════════════════════ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>36.7538</latitude_deg>
      <longitude_deg>3.0588</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

  </world>
</sdf>
